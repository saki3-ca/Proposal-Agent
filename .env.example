# Copy to .env for local runs. On Hugging Face Spaces / GitHub Actions use their secrets instead.
# Never put keys in the UI or commit them. .env is git-ignored.

# --- LLM providers (model names are in config/models.yaml) ---
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Supabase (server-side only; use the service_role key, never ship it to a browser) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# --- Tender digest: telegram | email | both | none ---
DIGEST_CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=

# --- Scraper identification (put a real contact e-mail) ---
TENDERBOT_CONTACT=

# --- OCR languages when tesseract is installed (scanned Bangla needs "ben") ---
OCR_LANGS=eng+ben
