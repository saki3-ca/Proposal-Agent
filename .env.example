# ====================================================================
# Supabase Frontend Credentials
# Found in Supabase Dashboard -> Project Settings -> API
# Copy this file to '.env' locally to set your real keys
# ====================================================================
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ====================================================================
# Backend AI Provider Credentials (Used by FastAPI backend on port 8000)
# ====================================================================
GROQ_API_KEY=your-groq-api-key-here
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
GEMINI_API_KEY=your-gemini-api-key-here

# Legacy Client-Side Keys (Deprecated - do not expose keys in frontend)
# VITE_GROQ_API_KEY=
# VITE_CLOUDFLARE_ACCOUNT_ID=
# VITE_CLOUDFLARE_API_TOKEN=